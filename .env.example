# 环境变量配置示例
# 复制此文件为 .env 并填入真实的配置值

# OpenAI API（如果使用）
OPENAI_API_KEY=your_openai_api_key_here

# Figma API 配置
FIGMA_API_KEY=your_figma_personal_access_token
FIGMA_TOKEN=your_figma_token
FIGMA_FILE_KEY=your_default_figma_file_key

# Vision LLM 配置（用于 UI 分析）
# 端点 URL - 根据你的 API 提供商调整
VISION_LLM_API_URL=https://your-api-provider.com/v1/responses
# API Token
VISION_LLM_TOKEN=your_llm_api_token
# 模型名称（可选，取决于你的 API 权限）
VISION_LLM_MODEL=gpt-4o-mini

# 可选配置
# FIGMA_API_RETRY_ATTEMPTS=3
# FIGMA_API_RETRY_DELAY_MS=1000
